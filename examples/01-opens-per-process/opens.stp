#!/usr/bin/env stap
// 01 in SystemTap: count openat() calls per process name.
// stap compiles this into a kernel module (needs kernel-devel for the running
// kernel); bpftrace and libbpf load verified BPF bytecode instead.
// Run: sudo stap opens.stp   (Ctrl-C prints the counts)
global opens

probe syscall.openat
{
    opens[execname()]++
}

probe end
{
    foreach (comm in opens+)
        printf("@[%s]: %d\n", comm, opens[comm])
}
