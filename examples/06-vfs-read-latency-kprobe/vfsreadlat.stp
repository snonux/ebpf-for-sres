#!/usr/bin/env stap
// 06 in SystemTap: vfs_read() latency through plain kprobes. kprobe.function
// needs no kernel debuginfo (kernel.function("vfs_read") would).
// Run: sudo stap vfsreadlat.stp   (Ctrl-C prints the histogram)
global start, usecs

probe kprobe.function("vfs_read")
{
    start[tid()] = gettimeofday_us()
}

probe kprobe.function("vfs_read").return
{
    if (tid() in start) {
        usecs <<< gettimeofday_us() - start[tid()]
        delete start[tid()]
    }
}

probe end
{
    printf("@usecs:\n")
    print(@hist_log(usecs))
}
